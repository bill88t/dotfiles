import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path


def _next_mountpoint(base="/run/media", prefix="veracrypt"):
    i = 1
    while Path(base, f"{prefix}{i}").exists():
        i += 1
    return str(Path(base, f"{prefix}{i}"))


def _parse_vera_args(args, include_hidden=False):
    password = ""
    hiddenpw = ""
    device = ""
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-p", "--password"):
            if i + 1 >= len(args):
                return None
            password = args[i + 1]
            i += 2
            continue
        if include_hidden and a in ("-P", "--hidden-password"):
            if i + 1 >= len(args):
                return None
            hiddenpw = args[i + 1]
            i += 2
            continue
        if a.startswith("-"):
            print(f"Unknown option: {a}", file=sys.stderr, flush=True)
            return None
        device = a
        i += 1
    return password, hiddenpw, device


def _verprivattach(args, stdin=None):
    parsed = _parse_vera_args(args, include_hidden=False)
    if parsed is None:
        return 1
    password, _, device = parsed
    if not device or not password:
        print("Usage: verprivattach -p password <device-or-container>", flush=True)
        return 1
    mountpoint = _next_mountpoint()
    print(f"Mounting {device} to {mountpoint}..", flush=True)
    rc = subprocess.run(
        [
            "veracrypt",
            "-t",
            "--pim=0",
            f"--password={password}",
            "--protect-hidden=no",
            "-k=",
            device,
            mountpoint,
            "--fs-options=relatime,ssd,discard=async,compress=zstd,space_cache=v2",
        ],
        check=False,
    ).returncode
    if rc != 0:
        print(f"Failed to mount {device}", flush=True)
        return rc
    print(f"Mounted hidden volume at {mountpoint}.", flush=True)
    old_cwd = os.getcwd()
    os.chdir(mountpoint)
    try:
        if Path(".loadsh").is_file():
            # Always drop into bash to load .loadsh (it's bash syntax).
            print("Entering environment, exit to unmount..", flush=True)
            time.sleep(0.1)
            env = {"HOME": mountpoint, "PATH": os.environ.get("PATH", "")}
            shell = shutil.which("bash") or "/bin/bash"
            subprocess.run(
                [shell, "-c", f'source "{mountpoint}/.loadsh"; exec bash'],
                env=env,
                cwd=mountpoint,
                check=False,
            )
            # Clear screen and reset cursor after the .loadsh shell exits.
            print("\x1bc", end="", flush=True)
            print("Unmounting..", flush=True)
        else:
            input("Press Enter to unmount...")
    finally:
        os.chdir(old_cwd)

    while True:
        subprocess.run(["sync", mountpoint], check=False)
        rc = subprocess.run(["veracrypt", "-t", "-u", device], check=False).returncode
        if rc == 0:
            parent_proc = subprocess.run(
                ["lsblk", "-no", "pkname", device],
                capture_output=True,
                text=True,
                check=False,
            )
            parent = parent_proc.stdout.strip()
            if parent:
                parent_dev = f"/dev/{parent}"
                subprocess.run(["udisksctl", "power-off", "-b", parent_dev], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                subprocess.run(["eject", parent_dev], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            return 0
        time.sleep(0.2)


def _verpubattach(args, stdin=None):
    parsed = _parse_vera_args(args, include_hidden=True)
    if parsed is None:
        return 1
    password, hiddenpw, device = parsed
    if not device or not password:
        print("Usage: verpubattach -p password [-P hidden-password] <device-or-container>", flush=True)
        return 1
    mountpoint = _next_mountpoint()
    print(f"Mounting {device} to {mountpoint}..", flush=True)
    cmd = ["veracrypt", "-t", "--pim=0", f"--password={password}", "-k=", device, mountpoint]
    if hiddenpw:
        cmd.extend(
            [
                f"--protection-password={hiddenpw}",
                "--protection-pim=0",
                "--protection-keyfiles=",
                "--protect-hidden=yes",
            ]
        )
    else:
        cmd.append("--protect-hidden=no")
    rc = subprocess.run(cmd, check=False).returncode
    if rc != 0:
        print(f"Failed to mount {device}", flush=True)
        return rc
    print(f"Mounted volume at {mountpoint}.", flush=True)
    input("Press Enter to unmount...")
    while True:
        subprocess.run(["sync", mountpoint], check=False)
        rc = subprocess.run(["veracrypt", "-t", "-u", device], check=False).returncode
        if rc == 0:
            parent_proc = subprocess.run(
                ["lsblk", "-no", "pkname", device],
                capture_output=True,
                text=True,
                check=False,
            )
            parent = parent_proc.stdout.strip()
            if parent:
                parent_dev = f"/dev/{parent}"
                subprocess.run(["udisksctl", "power-off", "-b", parent_dev], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                subprocess.run(["eject", parent_dev], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            return 0
        time.sleep(0.2)


aliases["verprivattach"] = _verprivattach
aliases["verpubattach"] = _verpubattach


# ---------------------------------------------------------------------------
# File-container mounts
#
# Mounts a VeraCrypt *file container* on some filesystem. If that filesystem
# is not mounted yet, it is mounted via udisks (looked up by PARTUUID through
# /dev/disk/by-partuuid). On unmount, the filesystem is unmounted ONLY if we
# mounted it; if it was already mounted before us, it is left alone.
# ---------------------------------------------------------------------------


def _enter_env(mountpoint):
    """Interaction phase: .loadsh environment if present, else press-enter."""
    if Path(mountpoint, ".loadsh").is_file():
        print("Entering environment, exit to unmount..", flush=True)
        time.sleep(0.1)
        env = {
            "HOME": mountpoint,
            "PATH": os.environ.get("PATH", ""),
            "TERM": os.environ.get("TERM", "xterm"),
        }
        shell = shutil.which("bash") or "/bin/bash"
        subprocess.run(
            [shell, "-c", f'source "{mountpoint}/.loadsh"; exec bash'],
            env=env,
            cwd=mountpoint,
            check=False,
        )
        # Clear screen and reset cursor after the .loadsh shell exits.
        print("\x1bc", end="", flush=True)
        print("Unmounting..", flush=True)
    else:
        input("Press Enter to unmount...")


def _power_off_parent(dev):
    parent_proc = subprocess.run(
        ["lsblk", "-no", "pkname", dev], capture_output=True, text=True, check=False
    )
    parent = parent_proc.stdout.strip()
    if parent:
        parent_dev = f"/dev/{parent}"
        subprocess.run(
            ["udisksctl", "power-off", "-b", parent_dev],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        subprocess.run(
            ["eject", parent_dev],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


def _verfile_mount(container, partuuid, password, hiddenpw=""):
    if not container or not password:
        print("_verfile_mount: container path and password are required", file=sys.stderr, flush=True)
        return 1

    mounted_by_us = False
    blockdev = None

    # Locate the backing block device, if a PARTUUID was given.
    if partuuid:
        link = Path(f"/dev/disk/by-partuuid/{partuuid}")
        if not link.exists():
            print(f"Error: PARTUUID={partuuid} not found on this system", file=sys.stderr, flush=True)
            return 1
        blockdev = str(link.resolve())

    # If the container is not visible yet, mount its filesystem via udisks.
    if not Path(container).exists():
        if not blockdev:
            print(
                f"Error: {container} not found and no PARTUUID given to mount its filesystem",
                file=sys.stderr,
                flush=True,
            )
            return 1

        # Already mounted somewhere else? (udisksctl refuses to double-mount.)
        if subprocess.run(["findmnt", "-S", blockdev], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False).returncode == 0:
            print(f"Filesystem of {blockdev} is already mounted, but {container} is missing.", file=sys.stderr, flush=True)
            return 1

        print(f"Mounting filesystem {blockdev} via udisks..", flush=True)
        mnt = subprocess.run(
            ["udisksctl", "mount", "-b", blockdev], capture_output=True, text=True, check=False
        )
        if mnt.returncode != 0:
            print(f"Failed to mount {blockdev}: {(mnt.stdout + mnt.stderr).strip()}", file=sys.stderr, flush=True)
            return 1
        mounted_by_us = True
        print((mnt.stdout + mnt.stderr).strip(), flush=True)

        # Wait for the container path to appear (filesystem settle).
        waited = 0
        while not Path(container).exists():
            time.sleep(1)
            waited += 1
            if waited >= 15:
                print(f"Timeout: {container} not found after mounting {blockdev}", file=sys.stderr, flush=True)
                subprocess.run(["udisksctl", "unmount", "-b", blockdev], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                _power_off_parent(blockdev)
                return 1
        print(f"{container} is available (waited {waited}s).", flush=True)

    # Pick a fresh veracrypt mountpoint, same scheme as the partition flow.
    mountpoint = _next_mountpoint()
    print(f"Mounting container {container} to {mountpoint}..", flush=True)

    cmd = ["veracrypt", "-t", "--pim=0", f"--password={password}", "-k=", container, mountpoint]
    if hiddenpw:
        cmd.extend(
            [
                f"--protection-password={hiddenpw}",
                "--protection-pim=0",
                "--protection-keyfiles=",
                "--protect-hidden=yes",
            ]
        )
    else:
        cmd.append("--protect-hidden=no")

    if subprocess.run(cmd, check=False).returncode != 0:
        print(f"Failed to mount container {container}", flush=True)
        if mounted_by_us:
            subprocess.run(["udisksctl", "unmount", "-b", blockdev], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        return 1

    print(f"Mounted container at {mountpoint}.", flush=True)

    old_cwd = os.getcwd()
    os.chdir(mountpoint)
    try:
        _enter_env(mountpoint)
    finally:
        os.chdir(old_cwd)

    # Dismount loop, same as the partition flow.
    while True:
        subprocess.run(["sync", mountpoint], check=False)
        if subprocess.run(["veracrypt", "-t", "-u", container], check=False).returncode == 0:
            if mounted_by_us:
                subprocess.run(["udisksctl", "unmount", "-b", blockdev], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                _power_off_parent(blockdev)
            else:
                print("Backing filesystem was already mounted, leaving it mounted.", flush=True)
            return 0
        time.sleep(0.2)


def _parse_ver_path_args(args, with_partuuid=True, with_hidden=False):
    password = ""
    hiddenpw = ""
    partuuid = ""
    container = ""
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-p", "--password"):
            if i + 1 >= len(args):
                return None
            password = args[i + 1]
            i += 2
        elif with_hidden and a in ("-P", "--hidden-password"):
            if i + 1 >= len(args):
                return None
            hiddenpw = args[i + 1]
            i += 2
        elif with_partuuid and a in ("-u", "--partuuid"):
            if i + 1 >= len(args):
                return None
            partuuid = args[i + 1]
            i += 2
        elif a.startswith("-"):
            print(f"Unknown option: {a}", file=sys.stderr, flush=True)
            return None
        else:
            container = a
            i += 1
    return password, hiddenpw, partuuid, container


def _verpathattach(args, stdin=None):
    parsed = _parse_ver_path_args(args)
    if parsed is None:
        return 1
    password, _, partuuid, container = parsed
    if not container or not password:
        print("Usage: verpathattach -p password [-u PARTUUID] /path/to/container", flush=True)
        return 1
    return _verfile_mount(container, partuuid, password)


def _verpathattachpub(args, stdin=None):
    parsed = _parse_ver_path_args(args, with_hidden=True)
    if parsed is None:
        return 1
    password, hiddenpw, partuuid, container = parsed
    if not container or not password:
        print("Usage: verpathattachpub -p password [-P hidden-password] [-u PARTUUID] /path/to/container", flush=True)
        return 1
    return _verfile_mount(container, partuuid, password, hiddenpw)


aliases["verpathattach"] = _verpathattach
aliases["verpathattachpub"] = _verpathattachpub


def _vdisk(args, stdin=None):
    if len(args) < 4:
        print("Usage: vdisk <name> <PARTUUID> <container_path> <password> [hidden_password]", flush=True)
        print("  Example: vdisk myvol a1b2c3d4-e5f6-7890-abcd-ef1234567890 /run/media/bill88t/TONK/vol hunter2", flush=True)
        return 1
    name, partuuid, container, password = args[:4]
    hiddenpw = args[4] if len(args) > 4 else ""
    if hiddenpw:
        def _generated(a, stdin=None):
            return _verfile_mount(container, partuuid, password, hiddenpw)
    else:
        def _generated(a, stdin=None):
            return _verfile_mount(container, partuuid, password)
    aliases[name] = _generated
    return 0


aliases["vdisk"] = _vdisk


def _verfileattach(args, stdin=None):
    parsed = _parse_ver_path_args(args, with_partuuid=False, with_hidden=True)
    if parsed is None:
        return 1
    password, hiddenpw, _, container = parsed
    if not container or not password:
        print("Usage: verfileattach -p password [-P hidden-password] /path/to/container", flush=True)
        return 1
    if not Path(container).exists():
        print(f"Error: container {container} not found", file=sys.stderr, flush=True)
        return 1

    mountpoint = _next_mountpoint()
    print(f"Mounting container {container} to {mountpoint}..", flush=True)

    cmd = ["veracrypt", "-t", "--pim=0", f"--password={password}", "-k=", container, mountpoint]
    if hiddenpw:
        cmd.extend(
            [
                f"--protection-password={hiddenpw}",
                "--protection-pim=0",
                "--protection-keyfiles=",
                "--protect-hidden=yes",
            ]
        )
    else:
        cmd.append("--protect-hidden=no")

    if subprocess.run(cmd, check=False).returncode != 0:
        print(f"Failed to mount container {container}", flush=True)
        return 1

    print(f"Mounted container at {mountpoint}.", flush=True)

    old_cwd = os.getcwd()
    os.chdir(mountpoint)
    try:
        _enter_env(mountpoint)
    finally:
        os.chdir(old_cwd)

    while True:
        subprocess.run(["sync", mountpoint], check=False)
        if subprocess.run(["veracrypt", "-t", "-u", container], check=False).returncode == 0:
            return 0
        time.sleep(0.2)


aliases["verfileattach"] = _verfileattach
