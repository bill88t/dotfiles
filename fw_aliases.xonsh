def _dex_cadmium(args, stdin=None):
    print("Stopping firewalld..")
    subprocess.run(["sudo", "systemctl", "stop", "firewalld"], check=False)

    print("Connecting..")
    subprocess.run(["adb", "connect", "192.168.1.231:5555"], check=False)

    print("Launching scrcpy..")
    subprocess.run(
        [
            "scrcpy",
            "--fullscreen",
            "--new-display=1920x1200/180",
            "--video-codec=h265",
            "-b16M",
            "--max-fps=60",
            "--mouse=uhid",
        ],
        check=False,
    )

    print("Killing adb..")
    subprocess.run(["adb", "disconnect"], check=False)
    subprocess.run(["adb", "kill-server"], check=False)

    print("Starting firewalld..")
    subprocess.run(["sudo", "systemctl", "start", "firewalld"], check=False)
    return 0


aliases["dex_cadmium"] = _dex_cadmium
